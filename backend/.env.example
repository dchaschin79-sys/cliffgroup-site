PORT=8788
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=true

# CORS. Include the production site and any preview/local origins that should submit forms.
ALLOWED_ORIGINS=https://cliffgroupflorida.com,https://www.cliffgroupflorida.com

# Admin dashboard at /admin, protected with HTTP Basic Auth.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Resend notifications
RESEND_API_KEY=re_replace_with_resend_key
RESEND_FROM_EMAIL=Cliff Group Florida <hello@cliffgroup.software>
INTERNAL_NOTIFICATION_EMAIL=hello@cliffgroup.software
EMAIL_ENABLED=true

# Public marketing site URL used in email copy and docs.
PUBLIC_SITE_URL=https://cliffgroupflorida.com
